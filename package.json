{
  "name": "sales-automation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "jobs:dev": "tsx --env-file=.env.local src/jobs/worker.ts --loop",
    "jobs:once": "tsx --env-file=.env.local src/jobs/worker.ts --once",
    "test:unit": "node --env-file=.env.local --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 3 && pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.2",
    "jose": "^6.0.11",
    "next": "16.2.10",
    "next-intl": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "signature_pad": "^5.1.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.15.9"
}
