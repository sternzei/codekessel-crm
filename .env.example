# --- Database ---------------------------------------------------------------
# App runtime connection: RLS-enforced role. Never use a superuser here.
DATABASE_URL=postgres://qcg_app:qcg_app_dev_pw@localhost:5433/qcg
# Migrations + seed: table owner (bypasses RLS by design).
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5433/qcg

# --- Secrets (generate real values: `openssl rand -base64 32`) ---------------
# Signs internal session cookies.
AUTH_SECRET=dev-only-auth-secret-change-me
# Signs external magic-link tokens. MUST differ from AUTH_SECRET.
TOKEN_SECRET=dev-only-token-secret-change-me

# --- App ---------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000

# Optional: magic-link token lifetime in hours (default 168 = 7 days). Clamped
# to [1, 720] in modules/tokens/policy.ts; a re-issue always mints a fresh token
# and supersedes the previous one.
# MAGIC_LINK_TTL_HOURS=168

# Set to true ONLY when the app sits behind a reverse proxy / load balancer
# that appends the real client IP to x-forwarded-for. When unset the header is
# ignored entirely: login rate limiting shares one fail-closed bucket and
# audit trails record no IP — never a spoofable one.
# TRUST_PROXY=true

# Optional: real aptitude-test provider entry point. The app appends
# participant_id=<uuid> when creating a test invitation.
# APTITUDE_TEST_BASE_URL=https://tests.example.org/start

# Optional: OpenRegister (Handelsregister) company import — admin-only lead
# ingestion. Without a key the register provider uses a demo-safe mock adapter
# (no API calls, no credits). Free tier: 500 credits/month.
# See docs/REGISTER-IMPORT.md for discovery/dedup/provenance details.
# OPENREGISTER_API_KEY=sk_live_xxx
# OPENREGISTER_BASE_URL=https://api.openregister.de

# Optional: provider city stamped onto generated PDFs (defaults to "Böblingen").
# PROVIDER_CITY=Böblingen

# --- Provided later by the client (placeholders, Phase 3+) -------------------
# WhatsApp Business Cloud. Setting the access token + phone-number id flips the
# messaging adapter to LIVE mode; until then it stays demo-safe (mock, no
# network). See plan.md §0d for the phased roll-out.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# Send Meta-approved HSM templates instead of free-form text on LIVE sends —
# required for business-initiated messages outside the 24h session window.
# Leave unset/false to keep the existing text path. ("true" | "false")
# WHATSAPP_USE_TEMPLATES=false
# Language code for the approved templates (defaults to "de").
# WHATSAPP_TEMPLATE_LANGUAGE=de
# Inbound webhook (delivery/read receipts + replies). The verify token answers
# Meta's GET subscribe handshake; the app secret validates the HMAC signature on
# POST callbacks. Leave both unset to keep the /api/webhooks/whatsapp route
# inert (no verification, no state changes).
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=QCG Demo <noreply@example.com>
