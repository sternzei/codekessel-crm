# --- Database ---------------------------------------------------------------
# App runtime connection: RLS-enforced role. Never use a superuser here.
DATABASE_URL=postgres://qcg_app:qcg_app_dev_pw@localhost:5433/qcg
# Migrations + seed: table owner (bypasses RLS by design).
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5433/qcg

# --- Secrets (generate real values: `openssl rand -base64 32`) ---------------
# Signs internal session cookies.
AUTH_SECRET=dev-only-auth-secret-change-me
# Signs external magic-link tokens. MUST differ from AUTH_SECRET.
TOKEN_SECRET=dev-only-token-secret-change-me

# --- App ---------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000

# --- Object storage ----------------------------------------------------------
# Where participant uploads + generated/signed PDFs are stored. "local" (the
# default) writes under ./var and is for dev only — local disk is ephemeral and
# unshared. Production must use one of:
#   db  — bytes live in Postgres (storage_objects). One durable store, one
#         backup, no credentials; the documents ride along in every pg_dump.
#   s3  — any S3-compatible backend (AWS S3, Cloudflare R2, MinIO). Pick this
#         when the document volume outgrows what you want inside a dump.
# Switching drivers is a copy of the bytes: stored keys are driver-agnostic
# (see scripts/migrate-storage-to-db.ts).
STORAGE_DRIVER=local
# Required when STORAGE_DRIVER=s3:
# S3_BUCKET=qcg-documents
# S3_REGION=eu-central-1
# For AWS S3 leave S3_ENDPOINT unset; set it for R2 / MinIO:
#   R2:    https://<accountid>.r2.cloudflarestorage.com
#   MinIO: http://minio:9000  (also set S3_FORCE_PATH_STYLE=true)
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# Optional key namespace inside the bucket (e.g. qcg/prod).
# S3_KEY_PREFIX=

# Optional: magic-link token lifetime in hours (default 168 = 7 days). Clamped
# to [1, 720] in modules/tokens/policy.ts; a re-issue always mints a fresh token
# and supersedes the previous one.
# MAGIC_LINK_TTL_HOURS=168

# Set to true ONLY when the app sits behind a reverse proxy / load balancer
# that appends the real client IP to x-forwarded-for. When unset the header is
# ignored entirely: login rate limiting shares one fail-closed bucket and
# audit trails record no IP — never a spoofable one.
# TRUST_PROXY=true

# Optional: real aptitude-test provider entry point. The app appends
# participant_id=<uuid> when creating a test invitation.
# APTITUDE_TEST_BASE_URL=https://tests.example.org/start

# Optional: OpenRegister (Handelsregister) company import — admin-only lead
# ingestion. Without a key the register provider uses a demo-safe mock adapter
# (no API calls, no credits). Free tier: 500 credits/month.
# See docs/REGISTER-IMPORT.md for discovery/dedup/provenance details.
# OPENREGISTER_API_KEY=sk_live_xxx
# OPENREGISTER_BASE_URL=https://api.openregister.de

# Optional: provider city stamped onto generated PDFs (defaults to "Böblingen").
# PROVIDER_CITY=Böblingen

# Production (NODE_ENV=production) also requires:
# - APP_BASE_URL as public HTTPS (not localhost / not http://)
# - AUTH_SECRET + TOKEN_SECRET ≥32 chars, not placeholders, must differ
# - TRUST_PROXY=true when behind nginx/Cloudflare/load balancer
# - STORAGE_DRIVER=db, or s3 (+ S3_BUCKET…), or ALLOW_LOCAL_STORAGE_IN_PROD=true
#   with a persistent volume for uploads/signed PDFs
# TRUST_PROXY=true
# ALLOW_LOCAL_STORAGE_IN_PROD=false

# --- WhatsApp Cloud API (PARKED — Meta setup can land later) ----------------
# Until these are set, the tasks UI uses click-to-chat (wa.me) and never
# pretends a Firmennummer Cloud send succeeded. See docs/MESSAGING.md.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Business display number this WABA represents (E.164, no "+"). Informational
# only — shown in the Postausgang; LIVE sends are addressed by the phone-number
# id above, not this value.
# WHATSAPP_SENDER_NUMBER=4915510151448
# WHATSAPP_API_VERSION=v21.0
# Send Meta-approved HSM templates instead of free-form text on LIVE sends —
# required for business-initiated messages outside the 24h session window.
# Leave unset/false to keep the existing text path. ("true" | "false")
# WHATSAPP_USE_TEMPLATES=false
# Language code for the approved templates (defaults to "de").
# WHATSAPP_TEMPLATE_LANGUAGE=de
# Operational warning threshold for ambiguous provider sends. Rows left in
# "sending" are never auto-retried; default 15 minutes allows normal provider
# latency before manager/admin reconciliation is requested.
# OUTBOX_STALE_SENDING_MINUTES=15
# Inbound webhook (delivery/read receipts + replies). The verify token answers
# Meta's GET subscribe handshake; the app secret validates the HMAC signature on
# POST callbacks. Leave both unset to keep the /api/webhooks/whatsapp route
# inert (no verification, no state changes).
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=QCG Demo <noreply@example.com>
# Rate-limit store: omit or "memory" for single-process/dev; production
# (NODE_ENV=production) defaults to Postgres table rate_limit_buckets.
# RATE_LIMIT_DRIVER=postgres

# Log verbosity: debug | info (default) | warn | error. Output is one JSON
# object per line, ready for any log collector.
# LOG_LEVEL=info
# Optional HTTP sink for logger.error / captureException. Without it errors only
# reach stdout, where a crashed server action is easy to miss.
# ERROR_WEBHOOK_URL=

# --- Anbieterangaben (Impressum + Datenschutzerklärung) ---------------------
# Participants open /t/[token] pages that ask for SV-Nummer, IBAN and a
# signature, so /impressum and /datenschutz are mandatory (§5 DDG,
# Art. 13 DSGVO). The first three are REQUIRED in production — the app refuses
# to start without them. Use "\n" to break the address into lines.
LEGAL_PROVIDER_NAME=QCG Demo GmbH
LEGAL_PROVIDER_ADDRESS=Musterstraße 1\n80331 München
LEGAL_PROVIDER_EMAIL=datenschutz@example.com
# LEGAL_PROVIDER_PHONE=+49 89 1234567
# Managing director / board — required for legal entities.
# LEGAL_PROVIDER_REPRESENTATIVE=Erika Mustermann
# LEGAL_REGISTER_ENTRY=Amtsgericht München, HRB 123456
# LEGAL_VAT_ID=DE123456789
# LEGAL_SUPERVISORY_AUTHORITY=
# Data protection officer, if appointed; defaults to LEGAL_PROVIDER_EMAIL.
# LEGAL_PRIVACY_CONTACT=
